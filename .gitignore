# local env files
.env*.local
.env

# claude code — la config local guarda comandos ya aprobados, y esos comandos
# pueden llevar claves embebidas (API keys, tokens). Las definiciones de
# agentes (.claude/agents/) sí se versionan: son parte del proyecto.
.claude/settings.local.json
.claude/scheduled_tasks.lock

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cypress
/cypress/videos
/cypress/screenshots

# IDE
.vscode
.idea
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Duplicados que crea macOS/iCloud al copiar un archivo ("robots 2.txt").
# Uno llegó a commitearse y quedó sirviéndose en público con una versión vieja
# de robots.txt — un archivo estático en `public/` se publica aunque nadie lo
# enlace.
* [0-9].*
